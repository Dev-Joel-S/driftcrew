// Preise und Upgrades. Gekauft wird nur angedockt an Stationen und Werften.
(
    start_credits: 300,
    // Bergungsgebühr nach Zerstörung: fester Betrag + Anteil der Kasse (höchstens die Kasse).
    salvage_base: 40,
    respawn_fee: 0.12,
    // Finanzen:
    //   dock_fee        Dockgebühr (× Ortsfaktor prices.dock, −20 % pro Rufstufe); wer innerhalb
    //                   dock_grace Sekunden wieder an derselben Station andockt, zahlt nicht noch einmal
    //   premium_share   Versicherung: Anteil jeder Auftragsbelohnung (mindestens premium_min),
    //   coverage        übernimmt diesen Anteil der Bergungskosten
    //   down_payment    Schiffskredit: Anzahlung, interest Zinsen auf den Rest, installments Raten
    //                   (je eine nach jedem erledigten Auftrag)
    //   drop_per_t      Markt: jede verkaufte Tonne drückt den Preis um diesen Anteil, nicht unter
    //   floor;          recovery = Erholungszeit in Sekunden
    //   demand_*        Nachfrage: Abstand (von, bis), Preisfaktor, Dauer, Anstiegszeit
    finance: (
        dock_fee: 12,
        dock_grace: 120.0,
        premium_share: 0.08,
        premium_min: 10,
        coverage: 0.7,
        down_payment: 0.25,
        interest: 0.12,
        installments: 8,
        drop_per_t: 0.035,
        floor: 0.55,
        recovery: 150.0,
        demand_interval: (240.0, 420.0),
        demand_factor: 1.35,
        demand_seconds: 300.0,
        demand_rise: 20.0,
    ),
    services: [
        (id: "ammo",   name: "Munition +10",    price: 40, effect: Ammo(10)),
        (id: "shield", name: "Schild aufladen", price: 60, effect: ShieldFull),
        (id: "repair", name: "Reparatur",       price: 90, effect: RepairFull),
        // Preise für Tanken und Triebwerke gelten für „ganz leer“ bzw. „alle ausgefallen“
        // und werden anteilig berechnet. Orte haben eigene Preisfaktoren (world.ron).
        (id: "engines", name: "Triebwerke instand setzen", price: 160, effect: RepairThrusters),
        (id: "fuel",    name: "Volltanken",                price: 70,  effect: Refuel),
    ],
    upgrades: [
        (id: "thrust1", name: "Triebwerkstuning I",  description: "+15 % Schub für alle Triebwerke.", price: 320, effect: ThrustMul(1.15)),
        (id: "thrust2", name: "Triebwerkstuning II", description: "+15 % Schub obendrauf.",          price: 640, effect: ThrustMul(1.15), requires: Some("thrust1")),
        (id: "armor1",  name: "Panzerplatten",       description: "+40 maximale Hülle.",              price: 360, effect: MaxHull(40.0)),
        (id: "armor2",  name: "Verbundpanzer",       description: "+60 maximale Hülle.",              price: 720, effect: MaxHull(60.0), requires: Some("armor1")),
        (id: "shield1", name: "Schildgenerator+",    description: "+40 maximaler Schild.",            price: 420, effect: MaxShield(40.0)),
        (id: "cargo1",  name: "Frachtmodule",        description: "+50 % Frachtraum.",               price: 280, effect: Cargo(0.5)),
        (id: "gyro",    name: "Gyro-Stabilisator",   description: "Dämpft Drehungen deutlich.",       price: 300, effect: Gyro(0.55)),
        (id: "mag",     name: "Großes Magazin",      description: "+10 Schuss Kapazität.",            price: 200, effect: MaxAmmo(10)),
        (id: "crane1",  name: "Langer Kranarm",      description: "+40 % Kranreichweite.",            price: 240, effect: CraneRange(1.4)),
        (id: "drill1",  name: "Diamantbohrkopf",     description: "Doppelt so schnell abbauen.",      price: 380, effect: DrillRate(2.0)),
        (id: "tank1",   name: "Zusatztank",          description: "+50 % Treibstoff.",               price: 260, effect: FuelTank(0.5)),
        (id: "drones",  name: "Reparaturdrohnen",    description: "Flicken die Hülle im Flug (0,5 pro Sekunde).", price: 680, effect: RepairDrones(0.5)),
        (id: "scan1",   name: "Weitbereichsscanner", description: "+60 % Scanner-Reichweite.",       price: 300, effect: ScanRange(1.6)),
    ],
    ore_prices: [
        (Ferrit, 9),
        (Kobalt, 16),
        (Solarit, 22),
        (Ionit, 30),
        (Schrott, 6),
    ],
    // Lackiererei (an Stationen mit Upgrade-Werkstatt). Jede Änderung kostet paint_price.
    paint_price: 80,
    paints: [
        (name: "Graphit",     color: "#3a3f47"),
        (name: "Stahlgrau",   color: "#9aa1a8"),
        (name: "Sand",        color: "#cbbf9f"),
        (name: "Rostorange",  color: "#c4602c"),
        (name: "Tannengrün",  color: "#3e5a43"),
        (name: "Tiefblau",    color: "#2b4a6f"),
        (name: "Signalrot",   color: "#a8322a"),
        (name: "Messing",     color: "#b8962e"),
        (name: "Elfenbein",   color: "#e4dfd2"),
        (name: "Violett",     color: "#5a4a7a"),
    ],
    // Flammen: ohne Farbe = Slotfarben (so sieht man, wer gerade schiebt).
    flames: [
        (name: "Slotfarben"),
        (name: "Plasmablau",  color: Some("#5fb4ff")),
        (name: "Glut",        color: Some("#ff8a3d")),
        (name: "Ionengrün",   color: Some("#4dffb0")),
        (name: "Violett",     color: Some("#b07cff")),
        (name: "Weißglut",    color: Some("#fff1d6")),
    ],
    // Bauteile, die der Kran aus Wracks reißt (Wert in Credits).
    salvage_names: ["Steuerdüse", "Navigationsrechner", "Reaktorspule", "Funkmodul", "Lebenserhaltung", "Gyroskop", "Schildemitter"],
    salvage_value: (40, 120),
    // Kartendaten: Preis pro neu kartierter Rasterzelle (100 × 100 m).
    chart_price: 3,
)
